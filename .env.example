# --- Core (ports match docker-compose.yml host mappings) ---
DATABASE_URL=postgres://flowpay:flowpaysecret@localhost:5433/flowpay
REDIS_URL=redis://localhost:6380
# REQUIRED: long random secret (min 32 chars). The API refuses to boot without it.
# JWTs expire after 24h.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
PORT=4000
NODE_ENV=development

# --- Solana (DEVNET ONLY — never mainnet for this project) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=solana-devnet
# Devnet USDC mint. Must be a VALID 32-byte Solana mint address — USDC intent
# creation is rejected while this is misconfigured. Override with your own
# devnet test mint if needed.
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3Gn9VffaKEzWVdcLJ
# Public address of the FlowPay treasury on devnet (receives user-signed deposits).
# No private key is stored server-side in this MVP (user-signed deposits only).
FLOWPAY_TREASURY_ADDRESS=

# --- Exchange (mock rates, NOT live market data) ---
EXCHANGE_FEE_BPS=50

# --- CORS: frontend origin(s) allowed to call the API (comma-separated, no '*') ---
FRONTEND_URL=http://localhost:3000
